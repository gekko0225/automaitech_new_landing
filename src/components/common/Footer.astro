---
const whatsappUrl = 'https://wa.me/573128460832';
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="brand-block">
      <a href="/" class="footer-brand">
        <span></span>
        Automaitech
      </a>

      <p>
        Sistemas inteligentes para negocios de servicios.
      </p>
    </div>

    <div class="footer-column">
      <h3>Sistemas</h3>
      <a href="/sistema-captacion-agendamiento">Captación y Agendamiento</a>
      <a href="/diagnostico-operativo">Diagnóstico Operativo</a>
    </div>

    <div class="footer-column">
      <h3>Empresa</h3>
      <a href="/">Inicio</a>
      <a href="/#proceso">Cómo trabajamos</a>
      <a href="/#sectores">Sectores</a>
      <a href={whatsappUrl}>Contacto</a>
    </div>

    <div class="footer-column">
      <h3>Legal</h3>
      <a href="/privacidad">Política de privacidad</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 Automaitech. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
    padding: 56px 0 28px;
  }

  .footer-grid {
    display: grid;
    gap: 34px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #0f172a;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .footer-brand span {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.08);
  }

  .brand-block p {
    max-width: 320px;
    margin-top: 14px;
    color: #475569;
    line-height: 1.7;
  }

  .footer-column {
    display: grid;
    gap: 12px;
  }

  .footer-column h3 {
    margin: 0 0 6px;
    color: #0f172a;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-column a {
    color: #475569;
    font-size: 15px;
    text-decoration: none;
  }

  .footer-column a:hover {
    color: #2563eb;
  }

  .footer-bottom {
    margin-top: 42px;
    border-top: 1px solid #e2e8f0;
    padding-top: 22px;
  }

  .footer-bottom p {
    margin: 0;
    color: #94a3b8;
    font-size: 14px;
  }

  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>