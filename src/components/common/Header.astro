---
import { LINKS } from '../../config/links';
---

<header class="site-header">
  <div class="container header-inner">
    <a href={LINKS.website.home} class="brand" aria-label="Automaitech inicio">
      <span class="brand-mark"></span>
      Automaitech
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <a href={LINKS.website.home}>Inicio</a>
      <a href="/#sistemas">Sistemas</a>
      <a href="/#proceso">Cómo trabajamos</a>
      <a href="/#sectores">Sectores</a>
      <a href={LINKS.whatsapp.url}>Contacto</a>
    </nav>

    <a href={LINKS.calendly.general} class="header-cta">
      Solicitar revisión
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(226, 232, 240, 0.75);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #0f172a;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand-mark {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.08);
  }

  .nav {
    display: none;
    align-items: center;
    gap: 28px;
  }

  .nav a {
    color: #475569;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: #0f172a;
  }

  .header-cta {
    display: none;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #2563eb;
    padding-inline: 20px;
    color: white;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 12px 24px rgba(37, 99, 235, 0.2);
    transition: 0.2s ease;
  }

  .header-cta:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  @media (min-width: 900px) {
    .nav,
    .header-cta {
      display: flex;
    }
  }
</style>