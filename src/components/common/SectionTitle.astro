---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
} = Astro.props;
---

<div class={`section-title ${align}`}>
  {eyebrow && (
    <p class="eyebrow">
      {eyebrow}
    </p>
  )}

  <h2>{title}</h2>

  {description && (
    <p class="description">
      {description}
    </p>
  )}
</div>

<style>
  .section-title {
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: 72px;
  }

  .section-title.left {
    margin-inline: 0;
    text-align: left;
  }

  .section-title.center {
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 12px;
    color: #2563eb;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
  }

  .description {
    margin-top: 20px;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .section-title {
      margin-bottom: 48px;
    }

    .description {
      font-size: 17px;
      line-height: 1.7;
    }
  }
</style>