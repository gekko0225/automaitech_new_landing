---
import { LINKS } from '../../config/links';
---

<section class="home-hero">
  <div class="hero-bg"></div>

  <div class="container hero-grid">
    <div class="copy reveal">
      <span class="badge">Automaitech</span>

      <h1>Sistemas inteligentes para negocios de servicios.</h1>

      <p>
        Diseñamos e implementamos sistemas que automatizan tareas repetitivas,
        organizan procesos y ayudan a tu negocio a captar más clientes mientras
        recuperas tiempo para hacerlo crecer.
      </p>

      <div class="actions">
       <a href={LINKS.website.diagnostic} class="btn-primary">
  Solicitar diagnóstico
</a>

        <a href="#sistemas" class="btn-secondary">
          Explorar sistemas
        </a>
      </div>
    </div>

    <div class="visual reveal">
      <div class="flow">
        <div class="flow-card">
          <span>Cliente</span>
          <strong>Nuevo contacto</strong>
        </div>

        <div class="line"></div>

        <div class="flow-card active">
          <span>Sistema inteligente</span>
          <strong>Atiende, organiza y guía</strong>
        </div>

        <div class="line"></div>

        <div class="flow-card">
          <span>Resultado</span>
          <strong>Negocio funcionando mejor</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 120px;
    background: #ffffff;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(37, 99, 235, .15), transparent 28%),
      radial-gradient(circle at 88% 62%, rgba(6, 182, 212, .13), transparent 24%),
      linear-gradient(rgba(15, 23, 42, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, .035) 1px, transparent 1px);
    background-size: auto, auto, 48px 48px, 48px 48px;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 72px;
    align-items: center;
  }

  .copy {
    max-width: 720px;
  }

  .badge {
    display: inline-flex;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: #eff6ff;
    padding: 10px 14px;
    color: #2563eb;
    font-size: 14px;
    font-weight: 800;
  }

  h1 {
    margin: 26px 0 0;
    color: #0f172a;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: .95;
    font-weight: 900;
    letter-spacing: -.07em;
  }

  p {
    max-width: 640px;
    margin: 28px 0 0;
    color: #475569;
    font-size: 19px;
    line-height: 1.85;
  }

  .actions {
    margin-top: 38px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .visual {
    position: relative;
  }

  .flow {
    border: 1px solid #e2e8f0;
    border-radius: 30px;
    background: rgba(255, 255, 255, .9);
    padding: 28px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, .12);
  }

  .flow-card {
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: white;
    padding: 24px;
  }

  .flow-card span {
    display: block;
    color: #2563eb;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .flow-card strong {
    display: block;
    margin-top: 8px;
    color: #0f172a;
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: -.03em;
  }

  .flow-card.active {
    background:
      radial-gradient(circle at top right, rgba(6, 182, 212, .16), transparent 36%),
      linear-gradient(135deg, #ffffff, #f8fafc);
  }

  .line {
    width: 2px;
    height: 32px;
    margin: 0 auto;
    background: linear-gradient(#2563eb, #06b6d4);
    border-radius: 999px;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.05fr .95fr;
    }
  }

  @media (max-width: 720px) {
    .home-hero {
      padding: 68px 0 86px;
    }

    .actions a {
      width: 100%;
    }
  }
</style>