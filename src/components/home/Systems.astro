---
const stages = [
  { number: '01', title: 'Atraer', text: 'Tus prospectos llegan desde Google, redes, anuncios, referidos o prospección.' },
  { number: '02', title: 'Capturar', text: 'Registramos la consulta y los datos necesarios para que ninguna oportunidad quede suelta.' },
  { number: '03', title: 'Calificar', text: 'Identificamos necesidad, intención, urgencia y encaje antes de consumir tiempo comercial.' },
  { number: '04', title: 'Dar seguimiento', text: 'Automatizaciones o agentes mantienen activa la conversación cuando aporta valor.' },
  { number: '05', title: 'Convertir', text: 'El prospecto avanza hacia una cita, llamada, visita o conversación comercial.' },
];
---

<section id="sistemas" class="systems">
  <div class="container">
    <div class="heading">
      <span>El sistema Automaitech</span>
      <h2>Del primer contacto a una oportunidad comercial real.</h2>
      <p>No instalamos herramientas sueltas. Diseñamos el recorrido que debe seguir cada prospecto y conectamos solo las piezas necesarias.</p>
    </div>

    <div class="grid">
      {stages.map((stage) => (
        <article class="system-card">
          <div class="number">{stage.number}</div>
          <h3>{stage.title}</h3>
          <p>{stage.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .systems { padding: 120px 0; background: #ffffff; }
  .heading { max-width: 780px; }
  .heading span { color: #2563eb; font-size: 13px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .heading h2 { margin: 18px 0 0; color: #0f172a; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.05; font-weight: 900; letter-spacing: -.05em; }
  .heading p { margin: 24px 0 0; color: #475569; font-size: 18px; line-height: 1.8; }
  .grid { display: grid; gap: 20px; margin-top: 64px; }
  .system-card { position: relative; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 26px; background: #ffffff; padding: 30px; box-shadow: 0 16px 42px rgba(15,23,42,.05); transition: .25s ease; }
  .system-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 34%); opacity: 0; transition: .25s ease; }
  .system-card:hover { transform: translateY(-6px); border-color: #bfdbfe; box-shadow: 0 24px 58px rgba(15,23,42,.08); }
  .system-card:hover::before { opacity: 1; }
  .system-card > * { position: relative; z-index: 1; }
  .number { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg,#2563eb,#06b6d4); color: #fff; font-size: 13px; font-weight: 900; letter-spacing: .08em; }
  .system-card h3 { margin: 26px 0 0; color: #0f172a; font-size: 26px; line-height: 1.08; font-weight: 900; letter-spacing: -.04em; }
  .system-card p { margin: 16px 0 0; color: #475569; line-height: 1.75; }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(5, 1fr); } .system-card { padding: 24px; } }
</style>
