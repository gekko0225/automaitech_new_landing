---
const { tone = 'blue' } = Astro.props;
---

<span class={`badge ${tone}`}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 700;
  }

  .blue {
    border: 1px solid #bfdbfe;
    background: #eff6ff;
    color: #2563eb;
  }

  .white {
    border: 1px solid rgba(255,255,255,.35);
    background: rgba(255,255,255,.14);
    color: white;
  }
</style>