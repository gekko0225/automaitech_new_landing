---
const {
  href = '#',
  variant = 'primary',
  class: className = '',
} = Astro.props;

const classes = {
  primary: 'btn-ui btn-primary-ui',
  secondary: 'btn-ui btn-secondary-ui',
  light: 'btn-ui btn-light-ui',
};
---

<a href={href} class={`${classes[variant]} ${className}`}>
  <slot />
</a>

<style>
  .btn-ui {
    position: relative;
    display: inline-flex;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    padding-inline: 28px;
    font-weight: 700;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }

  .btn-ui:hover {
    transform: translateY(-2px);
  }

  .btn-primary-ui {
    background: #2563eb;
    color: white;
    box-shadow: 0 12px 24px rgba(37, 99, 235, .22);
  }

  .btn-primary-ui:hover {
    background: #1d4ed8;
  }

  .btn-secondary-ui {
    border: 1px solid #cbd5e1;
    background: white;
    color: #0f172a;
  }

  .btn-secondary-ui:hover {
    background: #f8fafc;
  }

  .btn-light-ui {
    background: white;
    color: #2563eb;
    box-shadow: 0 12px 24px rgba(15, 23, 42, .14);
  }
</style>