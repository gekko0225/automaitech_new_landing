---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

import { LINKS } from '../config/links';
import { PRICING } from '../config/pricing';
---

<BaseLayout
  title="Confirma tu Diagnóstico Operativo | Automaitech"
  description="Completa el pago y el cuestionario para iniciar tu Diagnóstico Operativo Inteligente."
>
  <Header />

  <main class="confirm">
    <section class="container">
      <div class="hero">
        <span class="badge">Reserva completada</span>

        <h1>¡Tu sesión ya está agendada!</h1>

        <p>
          Ahora solo faltan dos pasos para comenzar el análisis de tu negocio y
          preparar tu Informe Operativo Inteligente antes de la reunión.
        </p>
      </div>

      <div class="progress" aria-label="Progreso del diagnóstico">
        <div class="done">
          <span>✓</span>
          <p>Reserva</p>
        </div>

        <div>
          <span>2</span>
          <p>Pago</p>
        </div>

        <div>
          <span>3</span>
          <p>Cuestionario</p>
        </div>

        <div>
          <span>4</span>
          <p>Diagnóstico</p>
        </div>
      </div>

      <div class="steps">
        <article class="step featured">
          <span class="number">01</span>

          <h2>Confirma tu diagnóstico</h2>

          <p>
            Para iniciar el trabajo necesitamos confirmar el servicio mediante
            el pago del diagnóstico. Este valor se descuenta completamente si
            implementas uno de nuestros sistemas.
          </p>

          <a href={LINKS.payment.diagnostic} class="btn-primary">
            Confirmar mi diagnóstico
          </a>

          <small>Pago seguro mediante Mercado Pago · {PRICING.diagnostic.display}</small>
        </article>

        <article class="step">
          <span class="number">02</span>

          <h2>Completa el cuestionario</h2>

          <p>
            Después del pago, dedica aproximadamente 15 minutos a responder el
            cuestionario. Esta información nos permitirá preparar un análisis
            personalizado antes de nuestra reunión.
          </p>

          <a href={LINKS.forms.diagnostic} class="btn-secondary">
            Completar cuestionario
          </a>
        </article>
      </div>

      <div class="after">
        <div>
          <span>Qué ocurre después</span>
          <h2>Llegaremos a la sesión con el análisis preparado.</h2>
        </div>

        <div class="after-list">
          <p>✓ Confirmamos tu pago.</p>
          <p>✓ Revisamos tus respuestas.</p>
          <p>✓ Analizamos tu operación.</p>
          <p>✓ Preparamos tu Informe Operativo Inteligente.</p>
          <p>✓ Revisamos contigo los resultados y próximos pasos.</p>
        </div>
      </div>

      <div class="note">
        <strong>¿Tienes alguna duda antes de continuar?</strong>
        <p>
          Escríbenos por WhatsApp y te ayudamos a completar el proceso.
        </p>
        <a href={LINKS.whatsapp.url}>Resolver una duda por WhatsApp</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .confirm {
    padding: 90px 0 120px;
    background:
      radial-gradient(circle at 80% 10%, rgba(37,99,235,.12), transparent 28%),
      #ffffff;
  }

  .hero {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .badge {
    display: inline-flex;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    background: #eff6ff;
    padding: 10px 14px;
    color: #2563eb;
    font-size: 14px;
    font-weight: 900;
  }

  h1 {
    margin: 26px 0 0;
    color: #0f172a;
    font-size: clamp(2.7rem, 6vw, 4.8rem);
    line-height: .98;
    font-weight: 900;
    letter-spacing: -.07em;
  }

  .hero p {
    max-width: 720px;
    margin: 26px auto 0;
    color: #475569;
    font-size: 19px;
    line-height: 1.8;
  }

  .progress {
    display: grid;
    gap: 12px;
    max-width: 900px;
    margin: 52px auto 0;
  }

  .progress div {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: white;
    padding: 14px 16px;
  }

  .progress span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
    font-weight: 900;
  }

  .progress .done span {
    background: #dcfce7;
    color: #16a34a;
  }

  .progress p {
    margin: 0;
    color: #0f172a;
    font-weight: 800;
  }

  .steps {
    display: grid;
    gap: 24px;
    margin-top: 70px;
  }

  .step {
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    background: white;
    padding: 34px;
    box-shadow: 0 20px 55px rgba(15, 23, 42, .06);
  }

  .step.featured {
    background:
      radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 34%),
      #ffffff;
    border-color: #bfdbfe;
  }

  .number {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border-radius: 18px;
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    color: white;
    font-weight: 900;
  }

  .step h2 {
    margin: 28px 0 0;
    color: #0f172a;
    font-size: 30px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -.04em;
  }

  .step p {
    margin-top: 16px;
    color: #475569;
    line-height: 1.75;
  }

  .step a {
    margin-top: 28px;
  }

  .step small {
    display: block;
    margin-top: 16px;
    color: #64748b;
    font-size: 14px;
    font-weight: 700;
  }

  .after {
    display: grid;
    gap: 30px;
    margin-top: 70px;
    border: 1px solid #e2e8f0;
    border-radius: 30px;
    background: #f8fafc;
    padding: 34px;
  }

  .after span {
    color: #2563eb;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .after h2 {
    max-width: 560px;
    margin: 18px 0 0;
    color: #0f172a;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -.05em;
  }

  .after-list {
    display: grid;
    gap: 12px;
  }

  .after-list p {
    margin: 0;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: white;
    padding: 16px;
    color: #0f172a;
    font-weight: 800;
  }

  .note {
    max-width: 760px;
    margin: 42px auto 0;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: white;
    padding: 26px;
    text-align: center;
    box-shadow: 0 14px 38px rgba(15, 23, 42, .05);
  }

  .note strong {
    color: #0f172a;
    font-size: 20px;
    font-weight: 900;
  }

  .note p {
    margin: 10px 0 0;
    color: #475569;
  }

  .note a {
    display: inline-flex;
    margin-top: 18px;
    color: #2563eb;
    font-weight: 900;
    text-decoration: none;
  }

  @media (min-width: 760px) {
    .progress {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .after {
      grid-template-columns: .95fr 1.05fr;
      align-items: center;
    }
  }

  @media (max-width: 720px) {
    .confirm {
      padding: 70px 0 90px;
    }
  }
</style>