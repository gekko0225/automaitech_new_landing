---
const programs = [
  {
    name: 'Plan Control',
    description: 'Ideal para iniciar hábitos saludables y reducir medidas.',
    price: '$250.000',
    image: 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Plan Transformación',
    description: 'Acompañamiento para bajar de peso de forma sostenible.',
    price: '$350.000',
    image: 'https://images.unsplash.com/photo-1609899537878-88d5ba429bdb?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Plan Premium',
    description: 'Programa avanzado con seguimiento y control personalizado.',
    price: '$550.000',
    image: 'https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Evaluación inicial',
    description: 'Revisión corporal, hábitos actuales y objetivos.',
    price: '$0',
    image: 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?q=80&w=1200&auto=format&fit=crop',
  },
];

const whatsappUrl = 'https://wa.me/57XXXXXXXXXX';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vitalia | Centro de bienestar y control de peso</title>
    <meta
      name="description"
      content="Programas personalizados para bajar de peso, mejorar hábitos y sentirte mejor con acompañamiento profesional."
    />
  </head>

  <body>
    <main>
      <section class="hero">
        <nav class="nav">
          <a href="#" class="brand">Vitalia</a>

          <div class="nav-actions">
            <a href="#programas">Programas</a>
            <a href="#como-funciona">Cómo funciona</a>
            <a href={whatsappUrl}>WhatsApp</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="copy">
            <span class="badge">Centro de bienestar</span>

            <h1>Tu bienestar, tu mejor versión.</h1>

            <p>
              Programas personalizados para bajar de peso, mejorar tus hábitos y
              sentirte mejor con acompañamiento profesional.
            </p>

            <div class="actions">
              <a href="#programas" class="primary">Agendar evaluación</a>
              <a href={whatsappUrl} class="secondary">Escribir por WhatsApp</a>
            </div>
          </div>
        </div>
      </section>

      <section class="trust">
        <article>
          <strong>Evaluación inicial</strong>
          <p>Conocemos tu punto de partida antes de recomendar un plan.</p>
        </article>

        <article>
          <strong>Planes personalizados</strong>
          <p>Diseñados según tus hábitos, objetivos y ritmo de vida.</p>
        </article>

        <article>
          <strong>Seguimiento</strong>
          <p>Acompañamiento para sostener cambios reales.</p>
        </article>

        <article>
          <strong>Resultados sostenibles</strong>
          <p>Enfoque en bienestar, salud y constancia.</p>
        </article>
      </section>

      <section id="programas" class="programs">
        <div class="section-heading">
          <span>Nuestros programas</span>
          <h2>Elige el plan ideal para ti.</h2>
          <p>
            Agenda tu evaluación, comparte tu objetivo y recibe una recomendación
            personalizada.
          </p>
        </div>

        <div class="grid">
          {
            programs.map((item) => (
              <article class="card">
                <img src={item.image} alt={item.name} loading="lazy" />

                <div class="card-body">
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>

                  <div class="price">
                    <strong>{item.price}</strong>
                    <span>{item.price === '$0' ? 'sin costo' : 'por mes'}</span>
                  </div>

                  <a href={whatsappUrl}>Ver plan</a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="como-funciona" class="how">
        <div class="section-heading">
          <span>¿Cómo funciona?</span>
          <h2>Empieza con claridad y acompañamiento.</h2>
        </div>

        <div class="how-grid">
          <article>
            <span>01</span>
            <h3>Agenda tu evaluación</h3>
            <p>Elige un horario disponible y confirma tus datos.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Recibimos tu información</h3>
            <p>Conocemos tus hábitos, objetivos y punto de partida.</p>
          </article>

          <article>
            <span>03</span>
            <h3>Diseñamos tu plan</h3>
            <p>Te orientamos con una ruta clara y personalizada.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Seguimiento</h3>
            <p>Acompañamos tu proceso para mantener avances.</p>
          </article>
        </div>
      </section>

      <section class="cta">
        <div>
          <span>Da el primer paso</span>
          <h2>Empieza hoy tu cambio.</h2>
          <p>Agenda una evaluación y descubre qué plan se ajusta mejor a ti.</p>
        </div>

        <a href={whatsappUrl}>Agendar evaluación</a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fbfbf4;
    color: #14210f;
    font-family: Georgia, "Times New Roman", serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    min-height: 700px;
    padding: 28px;
    background:
      linear-gradient(90deg, rgba(251,251,244,.98), rgba(251,251,244,.82), rgba(251,251,244,.3)),
      url("https://images.unsplash.com/photo-1594381898411-846e7d193883?q=80&w=1800&auto=format&fit=crop");
    background-position: center right;
    background-size: cover;
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    height: 72px;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: #2f7d32;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -.04em;
  }

  .nav-actions {
    display: none;
    gap: 22px;
    color: #36543a;
    font-family: Inter, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 800;
  }

  .hero-grid {
    max-width: 1180px;
    margin: 120px auto 0;
  }

  .copy {
    max-width: 660px;
  }

  .badge {
    display: inline-flex;
    border: 1px solid #b6d7a8;
    border-radius: 999px;
    background: #edf7e8;
    padding: 9px 14px;
    color: #2f7d32;
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 28px 0 0;
    color: #12200f;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: .9;
    letter-spacing: -.06em;
  }

  .copy p {
    max-width: 560px;
    margin-top: 26px;
    color: #475b42;
    font-family: Inter, system-ui, sans-serif;
    font-size: 20px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
    font-family: Inter, system-ui, sans-serif;
  }

  .primary,
  .secondary,
  .cta a,
  .card a {
    display: inline-flex;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding-inline: 28px;
    font-weight: 900;
  }

  .primary,
  .cta a {
    background: #3f8f35;
    color: white;
  }

  .secondary {
    border: 1px solid #9fcf93;
    color: #2f6f2d;
  }

  .trust,
  .programs,
  .how {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 24px;
  }

  .trust {
    display: grid;
    gap: 18px;
    padding-bottom: 20px;
  }

  .trust article,
  .how article,
  .card {
    border: 1px solid #dce9d4;
    border-radius: 24px;
    background: white;
    box-shadow: 0 18px 45px rgba(47, 125, 50, .08);
  }

  .trust article,
  .how article {
    padding: 24px;
  }

  .trust strong,
  .how h3,
  .how span {
    color: #2f7d32;
  }

  .trust p,
  .how p {
    color: #52634e;
    font-family: Inter, system-ui, sans-serif;
    line-height: 1.6;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .section-heading span {
    color: #2f7d32;
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 18px 0 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .section-heading p {
    color: #52634e;
    font-family: Inter, system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.7;
  }

  .grid,
  .how-grid {
    display: grid;
    gap: 22px;
  }

  .card {
    overflow: hidden;
  }

  .card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .card-body {
    padding: 24px;
    font-family: Inter, system-ui, sans-serif;
  }

  .card h3 {
    margin: 0;
    color: #14210f;
    font-size: 22px;
  }

  .card p {
    color: #52634e;
    line-height: 1.6;
  }

  .price strong {
    display: block;
    color: #2f7d32;
    font-size: 30px;
  }

  .price span {
    color: #7a8a76;
    font-size: 14px;
  }

  .card a {
    width: 100%;
    margin-top: 22px;
    border: 1px solid #9fcf93;
    color: #2f7d32;
  }

  .cta {
    max-width: 1120px;
    margin: 0 auto 90px;
    border-radius: 30px;
    background: linear-gradient(135deg, #2f7d32, #5fae4d);
    padding: 38px;
    color: white;
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .cta span {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .cta h2 {
    margin: 12px 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .cta p {
    font-family: Inter, system-ui, sans-serif;
  }

  .cta a {
    background: white;
    color: #2f7d32;
  }

  @media (min-width: 820px) {
    .nav-actions {
      display: flex;
    }

    .trust,
    .grid,
    .how-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .cta {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      padding: 22px;
    }

    .hero-grid {
      margin-top: 80px;
    }

    .actions a {
      width: 100%;
    }
  }
</style>