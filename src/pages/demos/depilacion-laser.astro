---
const zones = [
  {
    name: 'Axilas',
    description: 'Sesiones rápidas para una piel más suave.',
    price: '$80.000',
    image: 'https://images.unsplash.com/photo-1522337660859-02fbefca4702?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Media pierna',
    description: 'Ideal para reducir el vello de forma progresiva.',
    price: '$150.000',
    image: 'https://images.unsplash.com/photo-1519415510236-718bdfcd89c8?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Pierna completa',
    description: 'Tratamiento completo para resultados duraderos.',
    price: '$250.000',
    image: 'https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Rostro completo',
    description: 'Tratamiento delicado para piel suave y uniforme.',
    price: '$120.000',
    image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop',
  },
];

const whatsappUrl = 'https://wa.me/57XXXXXXXXXX';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LaserPure | Depilación láser avanzada</title>
    <meta
      name="description"
      content="Agenda sesiones de depilación láser segura, efectiva y progresiva. Axilas, piernas, rostro y zonas corporales."
    />
  </head>

  <body>
    <main>
      <section class="hero">
        <nav class="nav">
          <a href="#" class="brand">LaserPure</a>

          <div class="nav-actions">
            <a href="#zonas">Zonas</a>
            <a href="#proceso">Proceso</a>
            <a href={whatsappUrl}>WhatsApp</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="copy">
            <span class="badge">Depilación láser avanzada</span>

            <h1>Piel suave, todos los días.</h1>

            <p>
              Reduce el vello de forma progresiva con tecnología láser segura,
              sesiones rápidas y atención profesional.
            </p>

            <div class="actions">
              <a href="#zonas" class="primary">Agendar cita</a>
              <a href={whatsappUrl} class="secondary">Escribir por WhatsApp</a>
            </div>
          </div>
        </div>
      </section>

      <section class="features">
        <article>
          <strong>Tecnología avanzada</strong>
          <p>Equipos diseñados para sesiones seguras y efectivas.</p>
        </article>

        <article>
          <strong>Sesiones rápidas</strong>
          <p>Tratamientos ágiles según la zona seleccionada.</p>
        </article>

        <article>
          <strong>Resultados progresivos</strong>
          <p>Reducción gradual del vello con cada sesión.</p>
        </article>

        <article>
          <strong>Atención profesional</strong>
          <p>Orientación antes de iniciar tu tratamiento.</p>
        </article>
      </section>

      <section id="zonas" class="zones">
        <div class="section-heading">
          <span>Zonas populares</span>
          <h2>Elige la zona y agenda tu sesión.</h2>
          <p>
            Consulta precios, selecciona el tratamiento y confirma tu cita en
            pocos pasos.
          </p>
        </div>

        <div class="grid">
          {
            zones.map((item) => (
              <article class="card">
                <img src={item.image} alt={item.name} loading="lazy" />

                <div class="card-body">
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>

                  <div class="price">
                    <strong>{item.price}</strong>
                    <span>por sesión</span>
                  </div>

                  <a href={whatsappUrl}>Agendar</a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="proceso" class="how">
        <div class="section-heading">
          <span>¿Cómo funciona?</span>
          <h2>Agenda sin filas ni esperas.</h2>
        </div>

        <div class="how-grid">
          <article>
            <span>01</span>
            <h3>Elige la zona</h3>
            <p>Selecciona el tratamiento que quieres realizar.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Agenda tu sesión</h3>
            <p>Escoge el horario disponible que prefieras.</p>
          </article>

          <article>
            <span>03</span>
            <h3>Recibe confirmación</h3>
            <p>Te enviamos la información de tu cita por WhatsApp.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Asiste preparada</h3>
            <p>Te compartimos recomendaciones antes de la sesión.</p>
          </article>
        </div>
      </section>

      <section class="cta">
        <div>
          <span>Agenda rápida</span>
          <h2>Reserva tu cita en menos de un minuto.</h2>
          <p>Sin filas, sin esperas y con confirmación inmediata.</p>
        </div>

        <a href={whatsappUrl}>Agendar ahora</a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fff7ff;
    color: #27122f;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    min-height: 700px;
    padding: 28px;
    background:
      linear-gradient(90deg, rgba(255,247,255,.98), rgba(255,247,255,.78), rgba(255,247,255,.26)),
      url("https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1800&auto=format&fit=crop");
    background-position: center right;
    background-size: cover;
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    height: 72px;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: #8e3ab8;
    font-size: 32px;
    font-weight: 900;
    letter-spacing: -.06em;
  }

  .nav-actions {
    display: none;
    gap: 22px;
    color: #62416d;
    font-size: 14px;
    font-weight: 800;
  }

  .hero-grid {
    max-width: 1180px;
    margin: 120px auto 0;
  }

  .copy {
    max-width: 660px;
  }

  .badge {
    display: inline-flex;
    border: 1px solid #e4b7f5;
    border-radius: 999px;
    background: #f7e8ff;
    padding: 9px 14px;
    color: #8e3ab8;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 28px 0 0;
    color: #25102d;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: .9;
    font-weight: 900;
    letter-spacing: -.07em;
  }

  .copy p {
    max-width: 560px;
    margin-top: 26px;
    color: #62416d;
    font-size: 20px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .primary,
  .secondary,
  .cta a,
  .card a {
    display: inline-flex;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding-inline: 28px;
    font-weight: 900;
  }

  .primary,
  .cta a {
    background: #8e3ab8;
    color: white;
  }

  .secondary {
    border: 1px solid #c084dc;
    color: #7e2ea6;
  }

  .features,
  .zones,
  .how {
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 24px;
  }

  .features {
    display: grid;
    gap: 18px;
    padding-bottom: 20px;
  }

  .features article,
  .how article,
  .card {
    border: 1px solid #efd5f7;
    border-radius: 24px;
    background: white;
    box-shadow: 0 18px 45px rgba(142, 58, 184, .08);
  }

  .features article,
  .how article {
    padding: 24px;
  }

  .features strong,
  .how h3,
  .how span {
    color: #8e3ab8;
  }

  .features p,
  .how p {
    color: #6b4b75;
    line-height: 1.6;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .section-heading span {
    color: #8e3ab8;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 18px 0 0;
    color: #25102d;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -.05em;
  }

  .section-heading p {
    color: #6b4b75;
    font-size: 18px;
    line-height: 1.7;
  }

  .grid,
  .how-grid {
    display: grid;
    gap: 22px;
  }

  .card {
    overflow: hidden;
  }

  .card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .card-body {
    padding: 24px;
  }

  .card h3 {
    margin: 0;
    color: #25102d;
    font-size: 22px;
  }

  .card p {
    color: #6b4b75;
    line-height: 1.6;
  }

  .price strong {
    display: block;
    color: #8e3ab8;
    font-size: 30px;
  }

  .price span {
    color: #92709b;
    font-size: 14px;
  }

  .card a {
    width: 100%;
    margin-top: 22px;
    background: #8e3ab8;
    color: white;
  }

  .cta {
    max-width: 1120px;
    margin: 0 auto 90px;
    border-radius: 30px;
    background: linear-gradient(135deg, #8e3ab8, #b85bd6);
    padding: 38px;
    color: white;
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .cta span {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .cta h2 {
    margin: 12px 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .cta a {
    background: white;
    color: #8e3ab8;
  }

  @media (min-width: 820px) {
    .nav-actions {
      display: flex;
    }

    .features,
    .grid,
    .how-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .cta {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      padding: 22px;
    }

    .hero-grid {
      margin-top: 80px;
    }

    .actions a {
      width: 100%;
    }
  }
</style>