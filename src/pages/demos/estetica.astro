---
const treatments = [
  {
    name: 'Limpieza facial profunda',
    description: 'Elimina impurezas, hidrata y mejora la textura de tu piel.',
    price: '$90.000',
    image: 'https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Depilación láser',
    description: 'Reduce el vello de forma progresiva con tecnología segura.',
    price: '$120.000',
    image: 'https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Radiofrecuencia facial',
    description: 'Ayuda a mejorar la firmeza y luminosidad del rostro.',
    price: '$150.000',
    image: 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Masaje relajante',
    description: 'Reduce tensión, mejora la circulación y promueve bienestar.',
    price: '$80.000',
    image: 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Peeling químico',
    description: 'Renueva la piel y ayuda a mejorar manchas e imperfecciones.',
    price: '$140.000',
    image: 'https://images.unsplash.com/photo-1596178065887-1198b6148b2b?q=80&w=1200&auto=format&fit=crop',
  },
  {
    name: 'Ácido hialurónico labial',
    description: 'Realza el volumen y la hidratación natural de tus labios.',
    price: '$650.000',
    image: 'https://images.unsplash.com/photo-1608067365050-d771c8779f32?q=80&w=1200&auto=format&fit=crop',
  },
];

const whatsappUrl = 'https://wa.me/57XXXXXXXXXX';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bella Aurora Estética | Tratamientos faciales y corporales</title>
    <meta
      name="description"
      content="Agenda tratamientos estéticos faciales y corporales en Bella Aurora Estética. Limpieza facial, depilación láser, radiofrecuencia, peeling y más."
    />
  </head>

  <body>
    <main>
      <section class="hero">
        <nav class="nav">
          <a href="#" class="brand">Bella Aurora</a>

          <div class="nav-actions">
            <a href="#tratamientos">Tratamientos</a>
            <a href={whatsappUrl}>WhatsApp</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="copy">
            <span class="badge">Centro estético</span>

            <h1>Resalta tu belleza, siéntete increíble.</h1>

            <p>
              Tratamientos faciales y corporales diseñados para cuidar tu piel,
              relajarte y ayudarte a verte como quieres.
            </p>

            <div class="actions">
              <a href="#tratamientos" class="primary">Agendar tratamiento</a>
              <a href={whatsappUrl} class="secondary">Escribir por WhatsApp</a>
            </div>

            <div class="trust">
              <strong>+500</strong>
              <span>clientas atendidas</span>
            </div>
          </div>
        </div>
      </section>

      <section class="why">
  <div class="section-heading">
    <span>¿Por qué elegir Bella Aurora?</span>
    <h2>Cuidado, seguridad y resultados visibles.</h2>
  </div>

  <div class="why-grid">
    <article>
      <strong>+500 clientas atendidas</strong>
      <p>Experiencia acompañando tratamientos faciales y corporales.</p>
    </article>

    <article>
      <strong>Profesionales certificadas</strong>
      <p>Atención especializada y protocolos seguros.</p>
    </article>

    <article>
      <strong>Equipos de última generación</strong>
      <p>Tecnología estética para mejores resultados.</p>
    </article>

    <article>
      <strong>Valoración personalizada</strong>
      <p>Te orientamos según tu piel, objetivo y tratamiento ideal.</p>
    </article>
  </div>
</section>

      <section id="tratamientos" class="treatments">
        <div class="section-heading">
          <span>Nuestros tratamientos</span>
          <h2>Elige tu tratamiento y agenda en pocos pasos.</h2>
          <p>
            Consulta precios, revisa la información y reserva tu cita sin esperar
            respuesta manual.
          </p>
        </div>

        <div class="grid">
          {
            treatments.map((item) => (
              <article class="card">
                <img src={item.image} alt={item.name} loading="lazy" />

                <div class="card-body">
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>

                  <div class="price">
                    <strong>{item.price}</strong>
                    <span>por sesión</span>
                  </div>

                  <a href={whatsappUrl}>Agendar</a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="booking">
        <div>
          <span>Agenda fácil</span>
          <h2>Reserva tu cita en menos de un minuto.</h2>
          <p>
            Elige el tratamiento, envía tus datos y recibe confirmación por
            WhatsApp.
          </p>
        </div>

        <a href={whatsappUrl}>Agendar ahora</a>
      </section>

      <section class="benefits">
        <article>
          <strong>Confirmación rápida</strong>
          <p>Recibe la información de tu cita directamente por WhatsApp.</p>
        </article>

        <article>
          <strong>Recordatorios</strong>
          <p>Te ayudamos a recordar tu cita para evitar olvidos.</p>
        </article>

        <article>
          <strong>Atención personalizada</strong>
          <p>Resolvemos tus dudas antes de elegir el tratamiento.</p>
        </article>
      </section>
      
      <section class="how">
  <div class="section-heading">
    <span>¿Cómo funciona?</span>
    <h2>Agenda tu tratamiento en minutos.</h2>
  </div>

  <div class="how-grid">
    <article>
      <span>01</span>
      <h3>Elige el tratamiento</h3>
      <p>Consulta opciones, precios y beneficios.</p>
    </article>

    <article>
      <span>02</span>
      <h3>Selecciona fecha</h3>
      <p>Escoge el horario disponible que mejor se ajuste a ti.</p>
    </article>

    <article>
      <span>03</span>
      <h3>Recibe confirmación</h3>
      <p>Te enviamos los detalles de tu cita por WhatsApp.</p>
    </article>

    <article>
      <span>04</span>
      <h3>Disfruta tu cita</h3>
      <p>Asiste a tu tratamiento con todo listo.</p>
    </article>
  </div>
</section>

      <section class="faq">
        <div class="section-heading">
          <span>Preguntas frecuentes</span>
          <h2>Antes de agendar.</h2>
        </div>

        <div class="faq-list">
          <details>
            <summary>¿Debo pagar antes de asistir?</summary>
            <p>
              Algunos tratamientos pueden requerir anticipo para confirmar la
              reserva.
            </p>
          </details>

          <details>
            <summary>¿Puedo cambiar mi cita?</summary>
            <p>
              Sí. Escríbenos por WhatsApp con anticipación para revisar
              disponibilidad.
            </p>
          </details>

          <details>
            <summary>¿Qué tratamiento debo elegir?</summary>
            <p>
              Si tienes dudas, escríbenos y te orientamos según tu objetivo.
            </p>
          </details>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #070707;
    color: #fff;
    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    min-height: 720px;
    padding: 28px;
    background:
      linear-gradient(90deg, rgba(7,7,7,.96), rgba(7,7,7,.75), rgba(7,7,7,.2)),
      url("https://images.unsplash.com/photo-1515377905703-c4788e51af15?q=80&w=1800&auto=format&fit=crop");
    background-position: center right;
    background-size: cover;
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    height: 72px;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -.04em;
    color: #f8c46b;
  }

  .nav-actions {
    display: none;
    gap: 22px;
    color: rgba(255,255,255,.78);
    font-weight: 700;
  }

  .hero-grid {
    max-width: 1180px;
    margin: 110px auto 0;
  }

  .copy {
    max-width: 680px;
  }

  .badge {
    display: inline-flex;
    border: 1px solid rgba(248,196,107,.45);
    border-radius: 999px;
    padding: 9px 14px;
    color: #f8c46b;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 28px 0 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: .9;
    letter-spacing: -.07em;
  }

  .copy p {
    max-width: 560px;
    margin-top: 26px;
    color: rgba(255,255,255,.82);
    font-size: 20px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .primary,
  .secondary,
  .booking a,
  .card a {
    display: inline-flex;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding-inline: 28px;
    font-weight: 900;
  }

  .primary,
  .booking a {
    background: #f8c46b;
    color: #15110a;
  }

  .secondary {
    border: 1px solid rgba(248,196,107,.45);
    color: white;
  }

  .trust {
    margin-top: 36px;
    color: rgba(255,255,255,.78);
  }

  .trust strong {
    color: #f8c46b;
  }

  .treatments,
  .faq {
    max-width: 1180px;
    margin: 0 auto;
    padding: 100px 24px;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .section-heading span {
    color: #f8c46b;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 18px 0 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
  }

  .section-heading p {
    margin-top: 18px;
    color: rgba(255,255,255,.72);
    font-size: 18px;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    gap: 22px;
  }

  .card {
    overflow: hidden;
    border: 1px solid rgba(248,196,107,.22);
    border-radius: 24px;
    background: #101010;
    box-shadow: 0 20px 60px rgba(0,0,0,.28);
  }

  .card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .card-body {
    padding: 24px;
  }

  .card h3 {
    margin: 0;
    color: #f8c46b;
    font-size: 22px;
  }

  .card p {
    color: rgba(255,255,255,.74);
    line-height: 1.6;
  }

  .price {
    margin-top: 20px;
  }

  .price strong {
    display: block;
    color: #f8c46b;
    font-size: 30px;
  }

  .price span {
    color: rgba(255,255,255,.55);
    font-size: 14px;
  }

  .card a {
    width: 100%;
    margin-top: 22px;
    border: 1px solid rgba(248,196,107,.45);
    color: #f8c46b;
  }

  .booking {
    max-width: 1120px;
    margin: 0 auto;
    border-radius: 30px;
    background: #f7efe0;
    padding: 34px;
    color: #16110a;
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .booking span {
    color: #b7791f;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: 13px;
  }

  .booking h2 {
    margin: 12px 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .booking p {
    color: #594b36;
    line-height: 1.7;
  }

  .benefits {
    max-width: 1180px;
    margin: 30px auto 0;
    padding: 0 24px 90px;
    display: grid;
    gap: 18px;
  }

  .benefits article {
    border: 1px solid rgba(248,196,107,.18);
    border-radius: 22px;
    background: #101010;
    padding: 24px;
  }

  .benefits strong {
    color: #f8c46b;
  }

  .benefits p {
    color: rgba(255,255,255,.68);
    line-height: 1.6;
  }

  .faq-list {
    max-width: 820px;
    margin: auto;
    display: grid;
    gap: 14px;
  }

  details {
    border: 1px solid rgba(248,196,107,.2);
    border-radius: 18px;
    background: #101010;
    padding: 22px;
  }

  summary {
    cursor: pointer;
    color: #f8c46b;
    font-weight: 900;
  }

  details p {
    color: rgba(255,255,255,.72);
    line-height: 1.7;
  }

  @media (min-width: 820px) {
    .nav-actions {
      display: flex;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .booking {
      grid-template-columns: 1fr auto;
    }

    .benefits {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      padding: 22px;
    }

    .hero-grid {
      margin-top: 80px;
    }

    .actions a {
      width: 100%;
    }
  }
</style>