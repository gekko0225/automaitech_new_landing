---
import BaseLayout from '../layouts/BaseLayout.astro';

import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

import Hero from '../components/diagnostico/Hero.astro';
import Benefits from '../components/diagnostico/Benefits.astro';
import Process from '../components/diagnostico/Process.astro';
import ReportPreview from '../components/diagnostico/ReportPreview.astro';
import Methodology from '../components/diagnostico/Methodology.astro';
import Pricing from '../components/diagnostico/Pricing.astro';
import FAQ from '../components/diagnostico/FAQ.astro';
import FinalCTA from '../components/diagnostico/FinalCTA.astro';
---

<BaseLayout
  title="Diagnóstico Operativo Inteligente | Automaitech"
  description="Analizamos cómo funciona tu operación y te entregamos un plan claro para simplificar procesos, eliminar tareas innecesarias y automatizar solo aquello que realmente genera valor."
>
  <Header />

  <main>
    <Hero />
    <Benefits />
    <Process />
    <ReportPreview />
    <Methodology />
    <Pricing />
    <FAQ />
    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>