---
import BaseLayout from '../layouts/BaseLayout.astro';

const painPoints = [
  'Te escriben por WhatsApp sin contexto y tienes que hacer las mismas preguntas una y otra vez.',
  'No sabes qué prospectos tienen urgencia real, presupuesto o intención de compra.',
  'Tus campañas o redes sociales generan tráfico, pero los contactos llegan desordenados.',
  'Pierdes tiempo respondiendo curiosos mientras los leads buenos esperan.'
];

const features = [
  {
    title: 'Landing enfocada en conversión',
    text: 'Una página clara, rápida y pensada para que el visitante deje sus datos sin fricción.'
  },
  {
    title: 'Formulario inteligente',
    text: 'Captura nombre, negocio, necesidad, urgencia, presupuesto y datos clave para vender mejor.'
  },
  {
    title: 'Calificación de leads',
    text: 'Clasifica prospectos por prioridad para que respondas primero a quienes están más cerca de comprar.'
  },
  {
    title: 'WhatsApp con contexto',
    text: 'Prepara la conversación comercial con un mensaje inicial basado en la información del lead.'
  }
];

const niches = [
  'Clínicas estéticas y odontológicas',
  'Academias, cursos y formación',
  'Servicios profesionales',
  'Negocios locales que venden por WhatsApp'
];

const plans = [
  {
    name: 'Esencial',
    bestFor: 'Para validar rápido una oferta',
    items: ['Landing responsive', 'Copy de conversión', 'Formulario de contacto', 'Botón de WhatsApp']
  },
  {
    name: 'Profesional',
    bestFor: 'Para captar y priorizar prospectos',
    highlighted: true,
    items: ['Todo lo del plan Esencial', 'Formulario inteligente', 'Scoring de leads', 'Registro en Google Sheets o panel simple']
  },
  {
    name: 'Premium',
    bestFor: 'Para automatizar seguimiento',
    items: ['Todo lo del plan Profesional', 'Automatizaciones', 'Integración con CRM', 'Métricas y optimización inicial']
  }
];
---

<BaseLayout
  title="Automaitech | Landings inteligentes para captar leads por WhatsApp"
  description="Creo landings inteligentes para pymes que capturan datos, califican prospectos y preparan conversaciones comerciales por WhatsApp."
>
  <main>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Automaitech">Automaitech</a>
        <nav class="nav" aria-label="Principal">
          <a href="#solucion">Solución</a>
          <a href="#planes">Planes</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="header-cta" href="#contacto">Diagnóstico</a>
      </div>
    </header>

    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1556761175-4b46a572b786?auto=format&fit=crop&w=1800&q=82"
          alt=""
        />
      </div>

      <div class="container hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Landing inteligente para pymes</span>
          <h1>Convierte visitantes en prospectos listos para contactar por WhatsApp</h1>
          <p class="lead">
            Diseño landings que capturan datos, califican intención de compra y te ayudan a responder primero a los leads con más urgencia.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contacto">Quiero captar más clientes</a>
            <a class="btn btn-secondary" href="#flujo">Ver cómo funciona</a>
          </div>
        </div>

        <aside class="signal-panel" aria-label="Vista previa de lead calificado">
          <div class="signal-header">
            <span>Lead nuevo</span>
            <strong>Prioridad alta</strong>
          </div>
          <div class="signal-score">
            <span>87</span>
            <p>pts</p>
          </div>
          <div class="signal-data">
            <p><strong>Necesidad:</strong> captar más clientes</p>
            <p><strong>Urgencia:</strong> esta semana</p>
            <p><strong>Canal:</strong> WhatsApp</p>
          </div>
          <div class="message-preview">
            Hola, vi que quieres mejorar la captación de clientes. ¿Te parece si revisamos el alcance en 15 minutos?
          </div>
        </aside>
      </div>
    </section>

    <section class="section problem-section">
      <div class="container split">
        <div class="section-copy">
          <span class="eyebrow">El problema</span>
          <h2>Recibir mensajes no es lo mismo que tener oportunidades de venta</h2>
          <p>
            Muchas pymes ya tienen tráfico desde redes, referidos o anuncios, pero el contacto llega sin orden. El resultado: conversaciones largas, poco contexto y oportunidades que se enfrían.
          </p>
        </div>

        <div class="pain-list">
          {painPoints.map((point) => (
            <article class="pain-item">
              <span></span>
              <p>{point}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="solucion" class="section section-soft">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">La solución</span>
          <h2>Una página que captura, califica y prepara la conversación comercial</h2>
          <p>
            No es solo una landing bonita. Es un flujo simple para transformar visitas en prospectos accionables.
          </p>
        </div>

        <div class="feature-grid">
          {features.map((feature) => (
            <article class="card">
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="flujo" class="section flow-section">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Cómo funciona</span>
          <h2>Del visitante al WhatsApp con contexto</h2>
        </div>

        <div class="flow">
          <article>
            <span>01</span>
            <h3>El visitante llega</h3>
            <p>Desde Instagram, Google, anuncios, referidos o una campaña puntual.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Deja datos clave</h3>
            <p>El formulario pregunta lo necesario para entender necesidad, urgencia y presupuesto.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Se califica el lead</h3>
            <p>El sistema prioriza prospectos y deja lista la acción comercial recomendada.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Respondes mejor</h3>
            <p>Abres WhatsApp con contexto para iniciar una conversación más rápida y útil.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container split">
        <div class="section-copy">
          <span class="eyebrow">Para quién es</span>
          <h2>Ideal para negocios donde responder rápido puede cerrar la venta</h2>
          <p>
            Funciona especialmente bien cuando el cliente pregunta antes de comprar y necesita confianza antes de tomar una decisión.
          </p>
        </div>

        <div class="niche-list">
          {niches.map((niche) => (
            <span>{niche}</span>
          ))}
        </div>
      </div>
    </section>

    <section id="planes" class="section">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Planes</span>
          <h2>Empieza pequeño y escala cuando el negocio lo pida</h2>
          <p>
            La primera versión puede estar lista rápido. Si necesitas CRM, automatizaciones o integraciones, el alcance crece por etapas.
          </p>
        </div>

        <div class="pricing-grid">
          {plans.map((plan) => (
            <article class:list={['plan-card', { featured: plan.highlighted }]}>
              {plan.highlighted && <span class="plan-badge">Recomendado</span>}
              <h3>{plan.name}</h3>
              <p>{plan.bestFor}</p>
              <ul>
                {plan.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section extension-section">
      <div class="container split">
        <div class="section-copy">
          <span class="eyebrow">Después del MVP</span>
          <h2>La landing puede crecer hacia un sistema más completo</h2>
        </div>
        <p>
          Si el negocio necesita más, se puede extender con reservas, CRM simple, catálogos, encuestas, menú digital, automatizaciones o integración con herramientas existentes. Primero validamos captación; después ampliamos.
        </p>
      </div>
    </section>

    <section id="contacto" class="section contact-section">
      <div class="container contact-box">
        <div class="section-copy center">
          <span class="eyebrow">Siguiente paso</span>
          <h2>Cuéntame qué vendes y te digo si esta landing aplica para tu negocio</h2>
          <p>
            Déjame tus datos y reviso contigo si necesitas una versión esencial, profesional o una ampliación posterior.
          </p>
        </div>

        <form id="lead-form" class="lead-form" data-form>
          <div class="form-grid">
            <label>
              Nombre
              <input name="name" autocomplete="name" required placeholder="Ej. Andrea Gómez" />
            </label>

            <label>
              WhatsApp
              <input name="phone" inputmode="tel" autocomplete="tel" required placeholder="Ej. +57 300 123 4567" />
            </label>

            <label>
              Negocio
              <input name="business" required placeholder="Ej. Clínica Sonrisa" />
            </label>

            <label>
              Tipo de negocio
              <select name="businessType" required>
                <option value="">Seleccionar</option>
                <option>Clínica estética u odontológica</option>
                <option>Academia o curso</option>
                <option>Servicio profesional</option>
                <option>Negocio local</option>
                <option>Otro</option>
              </select>
            </label>

            <label>
              Necesidad principal
              <select name="need" required>
                <option value="">Seleccionar</option>
                <option value="leads">Captar más clientes</option>
                <option value="whatsapp">Ordenar mensajes de WhatsApp</option>
                <option value="sales">Aumentar ventas</option>
                <option value="automation">Automatizar seguimiento</option>
              </select>
            </label>

            <label>
              Urgencia
              <select name="urgency" required>
                <option value="">Seleccionar</option>
                <option value="high">Esta semana</option>
                <option value="medium">Este mes</option>
                <option value="low">Estoy evaluando opciones</option>
              </select>
            </label>

            <label class="full">
              ¿Qué quieres resolver?
              <textarea name="message" rows="4" placeholder="Cuéntame qué vendes y qué problema quieres solucionar"></textarea>
            </label>

            <label class="form-trap" aria-hidden="true">
              Sitio web
              <input name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button class="btn btn-primary form-submit" type="submit">Enviar diagnóstico</button>
          <p class="form-status" data-form-status role="status"></p>
        </form>
      </div>
    </section>
  </main>

  <script>
    const form = document.querySelector('[data-form]');
    const status = document.querySelector('[data-form-status]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submit = form.querySelector('button[type="submit"]');
      const data = Object.fromEntries(new FormData(form).entries());

      status.textContent = 'Enviando tu información...';
      submit?.setAttribute('disabled', 'true');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'No se pudo enviar el formulario.');
        }

        form.reset();
        status.textContent = 'Listo. Recibí tu información y te responderé pronto.';
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : 'No se pudo enviar el formulario. Intenta de nuevo.';
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>
