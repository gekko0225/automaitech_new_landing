---
import BaseLayout from '../layouts/BaseLayout.astro';

import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

import HomeHero from '../components/home/HomeHero.astro';
import BrandPromise from '../components/home/BrandPromise.astro';
import Systems from '../components/home/Systems.astro';
import Process from '../components/home/Process.astro';
import Philosophy from '../components/home/Philosophy.astro';
import Industries from '../components/home/Industries.astro';
import DiagnosticCTA from '../components/home/DiagnosticCTA.astro';
---

<BaseLayout
  title="Automaitech | Sistemas inteligentes para negocios de servicios"
  description="Diseñamos e implementamos sistemas inteligentes que automatizan tareas repetitivas, organizan procesos y ayudan a negocios de servicios a recuperar tiempo y captar más clientes."
>
  <Header />

  <main>
    <HomeHero />
    <BrandPromise />
    <Systems />
    <Process />
    <Philosophy />
    <Industries />
    <DiagnosticCTA />
  </main>

  <Footer />
</BaseLayout>