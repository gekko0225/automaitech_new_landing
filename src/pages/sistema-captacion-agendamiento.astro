---
import BaseLayout from '../layouts/BaseLayout.astro';

import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

import Hero from '../components/captacion/Hero.astro';
import Problems from '../components/captacion/Problems.astro';
import Solution from '../components/captacion/Solution.astro';
import HowItWorks from '../components/captacion/HowItWorks.astro';
import Includes from '../components/captacion/Includes.astro';
import Results from '../components/captacion/Results.astro';
import Pricing from '../components/captacion/Pricing.astro';
import FAQ from '../components/captacion/FAQ.astro';
import FinalCTA from '../components/captacion/FinalCTA.astro';
---

<BaseLayout
  title="Sistema de Captación y Agendamiento | Automaitech"
  description="Implementamos un sistema inteligente que convierte conversaciones en citas agendadas automáticamente para negocios de servicios."
>

  <Header />

  <main>

    <Hero />

    <Problems />

    <Solution />

    <HowItWorks />

    <Includes />

    <Results />

    <Pricing />

    <FAQ />

    <FinalCTA />

  </main>

  <Footer />

</BaseLayout>