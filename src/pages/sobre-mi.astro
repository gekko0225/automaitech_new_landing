---
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
  'Soluciones pequeñas antes que plataformas grandes.',
  'Copy claro antes que decoración innecesaria.',
  'Automatización útil solo cuando mejora el proceso comercial.',
  'Entrega por etapas para cuidar tiempo y presupuesto.'
];
---

<BaseLayout
  title="Sobre Automaitech | Landings inteligentes para pymes"
  description="Conoce el enfoque de Automaitech para crear landings inteligentes y soluciones simples de captación para pymes."
>
  <main>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Automaitech">Automaitech</a>
        <nav class="nav" aria-label="Principal">
          <a href="/landing-inteligente/">Servicio</a>
          <a href="/casos-de-uso/">Casos de uso</a>
          <a href="/#contacto">Contacto</a>
        </nav>
        <a class="header-cta" href="/#contacto">Diagnóstico</a>
      </div>
    </header>

    <section class="page-hero compact">
      <div class="container page-hero-inner single">
        <div>
          <span class="eyebrow">Sobre Automaitech</span>
          <h1>Tecnología simple para pymes que necesitan vender mejor</h1>
          <p class="lead">
            Automaitech nace para ayudar a negocios pequeños y profesionales a convertir visitas, mensajes y campañas en oportunidades comerciales más ordenadas.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <div class="section-copy">
          <span class="eyebrow">Enfoque</span>
          <h2>No se trata de construir más herramientas. Se trata de resolver el cuello de botella correcto.</h2>
        </div>
        <div class="content-card">
          <p>
            Muchas pymes no necesitan una plataforma compleja desde el primer día. Necesitan captar mejor, responder más rápido y entender qué prospectos merecen prioridad. Por eso el punto de partida es una landing inteligente: pequeña, medible y ampliable.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Principios de trabajo</span>
          <h2>Construir lo necesario, medir y luego ampliar</h2>
        </div>

        <div class="check-grid">
          {principles.map((item) => (
            <article class="check-card">
              <span>✓</span>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container cta-panel">
        <span class="eyebrow">Trabajemos</span>
        <h2>Si tu negocio vende por conversación, podemos ordenar el primer contacto</h2>
        <p>
          Empezamos con una versión concreta y dejamos las ampliaciones para cuando el negocio realmente las necesite.
        </p>
        <a class="btn btn-primary" href="/#contacto">Contar mi caso</a>
      </div>
    </section>
  </main>
</BaseLayout>
